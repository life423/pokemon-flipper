# eBay Browse API: developer.ebay.com, Application Keys, Production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Optional: your ZIP, so eBay quotes calculated shipping
EBAY_SHIP_TO_ZIP=

# OpenAI: photo analysis, reading searches and titles, comp checks
OPENAI_API_KEY=

# Optional: overrides the default model
OPENAI_MODEL=

# pkmnprices.com (Pro plan): raw prices and graded sold comps
PKMNPRICES_API_KEY=

# Optional: PokemonPriceTracker, kept as a cross-check
POKEMON_PRICE_TRACKER_API_KEY=

# Optional: server port (3000 by default)
PORT=
