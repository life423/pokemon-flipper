{
  "name": "pokemon-flipper",
  "version": "1.0.0",
  "description": "Find eBay Pok\u00e9mon card listings worth flipping, priced to the exact printing, with a max bid for every one.",
  "main": "server/app.ts",
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/app.ts",
    "start": "node --import tsx scripts/start.mjs",
    "test": "node scripts/test.mjs",
    "evaluate": "tsx scripts/evaluate.ts",
    "build": "vite build --config client/vite.config.js",
    "typecheck": "tsc -p . && tsc -p client",
    "db": "tsx scripts/database.ts",
    "db:check": "tsx scripts/check-database.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@azure/identity": "^4.14.1",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "mssql": "^12.7.13",
    "openai": "^7.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.5"
  }
}
