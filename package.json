{
  "name": "pokemon-flipper",
  "version": "1.0.0",
  "description": "Find eBay Pokémon card listings worth flipping, priced to the exact printing, with a max bid for every one.",
  "main": "server/app.ts",
  "scripts": {
    "predev": "pkill -f '[t]sx watch.*server/app.ts'; sleep 0.5; kill-port ${PORT:-3000}",
    "dev": "tsx watch --clear-screen=false server/app.ts",
    "start": "NODE_ENV=production tsx server/app.ts",
    "test": "node --import tsx --test \"test/**/*.test.*\"",
    "evaluate": "tsx scripts/evaluate.ts",
    "consistency": "tsx scripts/consistency.ts",
    "build": "vite build --config client/vite.config.js",
    "typecheck": "tsc -p . && tsc -p client"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "openai": "^7.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "kill-port": "^2.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.3"
  }
}
