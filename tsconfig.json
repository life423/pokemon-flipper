{
    // The server, the code shared with the client, scripts, and tests.
    // tsx runs the TypeScript directly; tsc only checks it.
    "compilerOptions": {
        "target": "ES2023",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "strict": true,
        "noUnusedLocals": true,
        "noImplicitOverride": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "resolveJsonModule": true,
        // While files move over: plain JavaScript runs alongside, unchecked.
        "allowJs": true,
        "checkJs": false,
        "types": ["node"]
    },
    "include": ["server", "shared", "scripts", "test"]
}
