{
    // The server, the code shared with the client, and scripts.
    // tsx runs the TypeScript directly; tsc only checks it.
    "compilerOptions": {
        "target": "ES2023",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "strict": true,
        "noUnusedLocals": true,
        "noImplicitOverride": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "resolveJsonModule": true,
        "types": ["node"]
    },
    // Tests run through tsx but aren't type-checked yet: their fixtures are
    // deliberately partial objects. Typed fixture builders would fix that.
    "include": ["server", "shared", "scripts"]
}
